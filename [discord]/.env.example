# ── Discord bot ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=paste_your_bot_token_here

# ── FiveM server status monitor ──────────────────────────────────────────────
# The CFX join code for your server (the part after cfx.re/join/ in your link).
# Example: if your link is https://cfx.re/join/abc123 then set FIVEM_CFX_CODE=abc123
# Leave blank to disable the status monitor.
FIVEM_CFX_CODE=your_cfx_code_here

# ── GitHub auto-pull webhook ─────────────────────────────────────────────────
# Generate a strong random secret and paste it in BOTH here and in the GitHub
# webhook settings (Settings → Webhooks → Secret).
# Quick way to generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=generate_a_strong_random_secret_here

# Absolute path to the repo on your VPS that should be kept in sync.
# Example: /srv/fivem/resources   or   /home/youruser/fivem-server
REPO_PATH=/absolute/path/to/your/fivem/repo

# The branch GitHub should watch for pushes on.
BRANCH=main

# Port the webhook listener binds to. Open this port in your firewall.
WEBHOOK_PORT=9000
