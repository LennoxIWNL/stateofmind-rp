## State of Mind RP - server.cfg EXAMPLE
## Copy this file to `server.cfg` and fill in the real secrets.
## `server.cfg` itself is gitignored so secrets never get committed.
##
## SOM FRAMEWORK REBUILD IN PROGRESS.
## The QBox framework layer has been removed. som-core is not finished, so
## this config will NOT produce a playable server yet. The ensure list below
## reflects the target state; lines that depend on unfinished work are
## commented out and marked TODO.

## You CAN edit the following:
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 6
# Get a Steam Web API key from https://steamcommunity.com/dev/apikey
set steam_webApiKey "YOUR_STEAM_WEB_API_KEY"
sets tags "roleplay, som, custom framework"

## You MAY edit the following:
# Get a license key from https://keymaster.fivem.net
sv_licenseKey "YOUR_CFX_LICENSE_KEY"
sv_hostname "State of Mind RP"
sets sv_projectName "State of Mind RP"
sets sv_projectDesc "Deep, interaction-driven roleplay on the custom SOM framework."
sets locale "en-US"
load_server_icon server-icon.png
set sv_enforceGameBuild 2944
set mysql_connection_string "mysql://root:YOUR_DB_PASSWORD@localhost/stateofmindrp?charset=utf8mb4"

# Lennox-Anticheat's webhooks (Lennox-NUIBlocker reuses lac_webhook_events).
# Create NEW webhooks in Discord's channel settings for these - the values
# that used to be hardcoded in those resources' config.lua are burned and
# must never be reused, even here.
set lac_webhook_bans "YOUR_DISCORD_WEBHOOK_URL"
set lac_webhook_kicks "YOUR_DISCORD_WEBHOOK_URL"
set lac_webhook_flags "YOUR_DISCORD_WEBHOOK_URL"
set lac_webhook_events "YOUR_DISCORD_WEBHOOK_URL"
set lac_webhook_connections "YOUR_DISCORD_WEBHOOK_URL"

# ps-mdt's webhooks (mug shots, clock-in notifications).
# som-phone: a secret mixed into passcode hashes. Never put this in a file in
# the repo. Changing it invalidates every existing passcode.
set som_phone_pepper "CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# som-staff: 1 turns the connection whitelist on. Whitelist every staff licence first
# (whitelist add license:<hex> note from the console) or nobody can join.
set som_whitelist 0
# 1 logs every server callback (name, source, result, time) for bug hunting. Leave 0 in production.
set som_debug 0
# som-phone: Chirp reports (optional).
set som_phone_webhook "YOUR_DISCORD_WEBHOOK_URL"

# som-heists: heist starts and endings (optional).
set som_heist_webhook "YOUR_DISCORD_WEBHOOK_URL"

# som-launder: bills minted and washed.
set som_launder_webhook "YOUR_DISCORD_WEBHOOK_URL"

# som-evidence: collection, custody and lab events.
set som_evidence_webhook "YOUR_DISCORD_WEBHOOK_URL"

# som-court: case, ruling and warrant events.
set som_court_webhook "YOUR_DISCORD_WEBHOOK_URL"

# som-jail: bookings, releases and escapes.
set som_jail_webhook "YOUR_DISCORD_WEBHOOK_URL"

set psmdt_webhook_mugshot "YOUR_DISCORD_WEBHOOK_URL"
set psmdt_webhook_clockin "YOUR_DISCORD_WEBHOOK_URL"

# qb-smallresources' webhooks. Also burned, also need new ones in Discord.
set qbsmall_webhook_economy "YOUR_DISCORD_WEBHOOK_URL"
set qbsmall_webhook_inventory "YOUR_DISCORD_WEBHOOK_URL"
set qbsmall_webhook_crime "YOUR_DISCORD_WEBHOOK_URL"
set qbsmall_webhook_player_staff "YOUR_DISCORD_WEBHOOK_URL"
set qbsmall_webhook_comms "YOUR_DISCORD_WEBHOOK_URL"
set qbsmall_webhook_system "YOUR_DISCORD_WEBHOOK_URL"

# ---------------------------------------------------------------------------
# Everything else lives in som.cfg, which IS tracked in git.
#
# Boot order, convars and permissions all moved there so a push carries them.
# This file keeps only what must not be committed: the licence key, the Steam
# key, the database string and the host settings.
#
# If som-core reports the cfg marker as MISSING at boot, this line did not find
# the file.
# ---------------------------------------------------------------------------
exec som.cfg
