## State of Mind RP - server.cfg EXAMPLE
## Copy this file to `server.cfg` and fill in the real secrets.
## `server.cfg` itself is gitignored so secrets never get committed.
##
## SOM FRAMEWORK REBUILD IN PROGRESS.
## The QBox framework layer has been removed. som-core is not finished, so
## this config will NOT produce a playable server yet. The ensure list below
## reflects the target state; lines that depend on unfinished work are
## commented out and marked TODO.

## You CAN edit the following:
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 6
# Get a Steam Web API key from https://steamcommunity.com/dev/apikey
set steam_webApiKey "YOUR_STEAM_WEB_API_KEY"
sets tags "roleplay, som, custom framework"

## You MAY edit the following:
# Get a license key from https://keymaster.fivem.net
sv_licenseKey "YOUR_CFX_LICENSE_KEY"
sv_hostname "State of Mind RP"
sets sv_projectName "State of Mind RP"
sets sv_projectDesc "Deep, interaction-driven roleplay on the custom SOM framework."
sets locale "en-US"
load_server_icon server-icon.png
set sv_enforceGameBuild 2944
set mysql_connection_string "mysql://root:YOUR_DB_PASSWORD@localhost/stateofmindrp?charset=utf8mb4"

# Voice config
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly true
setr voice_defaultCycle "GRAVE"
setr voice_defaultVolume 0.3
setr voice_enableRadioAnim 1
setr voice_syncData 1
setr voice_enableUi 0

setr UseTarget true

# ox_inventory config (convar based, not a config.lua)
# The som bridge lives at ox_inventory/modules/bridge/som/. It is a patch to a
# third-party resource and must be re-applied on every ox_inventory upgrade.
# See som-core/README.md.
setr inventory:framework "som"
# Money is NOT an inventory item in SOM. som-core owns cash, bank, crypto and
# dirty outright. Leaving this empty stops ox registering a 'money' account
# item, which would otherwise hold the authoritative cash count and drift from
# som_character_money. Cash is still robbable, via som-theft.
setr inventory:accounts "[]"
setr inventory:slots 40
setr inventory:weight 120000
setr inventory:target false
# No ox_inventory notifications. SOM has its own notification style in som-ui,
# and two competing toast designs on screen is the inconsistency we are trying
# to remove. itemnotify kills the item pickup and drop cards, weaponnotify the
# equip and holster ones. Error toasts are redirected to som-ui by the som
# bridge rather than silenced, so failures still say why.
setr inventory:itemnotify 0
setr inventory:weaponnotify 0
setr inventory:disablesetupnotification 1
setr inventory:police '["police"]'
setr inventory:imagepath "nui://ox_inventory/web/images"

# ---------------------------------------------------------------------------
# Which cfg is this?
#
# som-core prints this value at boot. If it reports MISSING, the file being
# executed is not this file, and editing this one will never change anything.
# That is the first thing to check when permissions do not apply.
# ---------------------------------------------------------------------------
sets som_cfg_marker "repo-server-cfg"

# ---------------------------------------------------------------------------
# Boot order
# ---------------------------------------------------------------------------

# Cfx stock managers
#
# Stock `chat` is NOT started: som-chat replaces it. It is a command line only,
# hidden unless typing, and starting both would put two input boxes on screen.
ensure mapmanager
ensure spawnmanager
ensure sessionmanager
ensure basic-gamemode
ensure hardcap
ensure baseevents

# connectqueue is NOT started in dev mode.
#
# Its Config.JoinDelay is 120000ms, so it holds every connection for two
# minutes after a restart while other resources settle. That used to be hidden
# by the long boot caused by [assets-streams]; now that dev mode boots in
# seconds, it is simply two minutes of waiting per restart.
#
# Re-enable it for the full boot. To keep it while iterating, lower JoinDelay
# in connectqueue/server/sv_queue_config.lua instead.
#
# Note it sets Config.DisableHardCap = true, so with it off, hardcap enforces
# sv_maxclients normally.
#
# ensure connectqueue

# Anti-cheat first so it monitors from the first connect
ensure [anticheats]

# Libraries
ensure ox_lib
ensure oxmysql
ensure PolyZone
ensure screenshot-basic

# SOM framework
# som-core must start before anything that reads player state.
ensure som-assets
ensure som-core
ensure som-ui
ensure som-chat
# sleepless_interact replaces qb-target, which was escrow protected and
# unversioned so it could never be read, patched or upgraded. Indicator circles
# are configured to appear only while Left Alt is HELD, in brand pink, in
# client/modules/config.lua. That file is a SOM patch, re-apply on upgrade.
ensure sleepless_interact
ensure som-interact
ensure ox_inventory
# som-multichar is what lets a player enter the world at all. Without it
# nobody gets past the loading screen.
ensure som-multichar
ensure som-theft
ensure som-economy
ensure som-phone
ensure som-pause
ensure som-id
ensure som-radial

# Interior shells for the character select scene. Started by name because dev
# mode does not ensure [assets-streams], and without it the shell model does
# not exist and som-multichar falls back to the plain world scene.
ensure jordqn_free_shells

# Coloured map, replacing minimap_main_map.gfx and the minimap tiles, which is
# both the minimap and the native pause menu map. 19MB, named explicitly
# because dev mode skips the rest of [assets-streams].
ensure karma-minimap

# som-compat answers exports['qb-core']:GetCoreObject() for preserved
# third-party resources (ps-mdt). It declares provide 'qb-core', so it must
# never run alongside qbx_core. qbx_core is now removed, so this is safe.
ensure som-compat

# Voice
ensure [voice]

# ===========================================================================
# DEV MODE (currently active)
#
# Framework only. Boots in seconds because it skips the ~5GB of streamed
# assets and every leftover QBCore-dependent resource.
#
# Folder-wide ensures are deliberately NOT used. `ensure [custom]` and
# `ensure [standalone]` would start elixir-base, elixir-hud, elixir-petshop,
# r14-evidence, som-spray, ox_doorlock and Lennox-DoorCreator, all of which
# still call QBCore members som-compat does not implement. They are kept on
# disk only for the streamed props inside them.
#
# To go back to a full boot, comment this block out and uncomment FULL BOOT.
# ===========================================================================

ensure ps-mdt

# ===========================================================================
# FULL BOOT (inactive)
#
# Uncomment once the leftover resources have had their stream/ folders
# salvaged into [assets-streams] and their QBCore-dependent Lua removed.
# ===========================================================================
#
# ensure [standalone]
# ensure [custom]
# ensure [som]
#
# Heavy streaming assets load LAST so the framework is up and the server is
# responsive (heartbeat OK) before the ~5GB of ped/vehicle streams mount.
# ensure [assets-streams]
#
# ensure [qb]
# ensure [new]
# ensure [jobs]

## Permissions ##
# SOM uses som.* ACEs, checked with IsPlayerAceAllowed in som-core.
# See som-core/server/permissions.lua and shared/config.lua.
add_ace group.admin command allow

# Owner - license identifier is reliable (works without Steam)
add_principal identifier.license:YOUR_LICENSE_IDENTIFIER group.admin
add_principal identifier.license:YOUR_LICENSE_IDENTIFIER group.god
# Steam identifier (requires steam_webApiKey to resolve)
add_principal identifier.steam:YOUR_STEAM_IDENTIFIER group.admin
add_principal identifier.steam:YOUR_STEAM_IDENTIFIER group.god

# SOM permission tiers
add_ace group.god som.god allow
add_ace group.god som.admin allow
add_ace group.god som.mod allow
add_ace group.admin som.admin allow
add_ace group.admin som.mod allow
add_ace group.mod som.mod allow

# Gods may run any command
add_ace group.god command allow

# Inheritance
add_principal group.god group.admin
add_principal group.admin group.mod

# Resources
add_ace resource.som-core command allow
