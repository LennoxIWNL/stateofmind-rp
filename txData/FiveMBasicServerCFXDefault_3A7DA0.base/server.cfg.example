## State of Mind RP - server.cfg EXAMPLE
## Copy this file to `server.cfg` and fill in the real secrets.
## `server.cfg` itself is gitignored so secrets never get committed.
##
## SOM FRAMEWORK REBUILD IN PROGRESS.
## The QBox framework layer has been removed. som-core is not finished, so
## this config will NOT produce a playable server yet. The ensure list below
## reflects the target state; lines that depend on unfinished work are
## commented out and marked TODO.

## You CAN edit the following:
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 6
# Get a Steam Web API key from https://steamcommunity.com/dev/apikey
set steam_webApiKey "YOUR_STEAM_WEB_API_KEY"
sets tags "roleplay, som, custom framework"

## You MAY edit the following:
# Get a license key from https://keymaster.fivem.net
sv_licenseKey "YOUR_CFX_LICENSE_KEY"
sv_hostname "State of Mind RP"
sets sv_projectName "State of Mind RP"
sets sv_projectDesc "Deep, interaction-driven roleplay on the custom SOM framework."
sets locale "en-US"
load_server_icon server-icon.png
set sv_enforceGameBuild 2944
set mysql_connection_string "mysql://root:YOUR_DB_PASSWORD@localhost/stateofmindrp?charset=utf8mb4"

# ---------------------------------------------------------------------------
# Everything else lives in som.cfg, which IS tracked in git.
#
# Boot order, convars and permissions all moved there so a push carries them.
# This file keeps only what must not be committed: the licence key, the Steam
# key, the database string and the host settings.
#
# If som-core reports the cfg marker as MISSING at boot, this line did not find
# the file.
# ---------------------------------------------------------------------------
exec som.cfg
